{
  "name": "wa-bot",
  "version": "1.2.1",
  "description": "TODO",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node dist/index.js",
    "watch": "nodemon --watch src --ext ts --exec ts-node src/index.ts",
    "build": "tsc",
    "prettier": "prettier --write \"src/**/*.ts\"",
    "pm2": "npm run reset && npm run build && pm2 delete wa-bot && pm2 start ecosystem.config.js && pm2 save",
    "clear-logs": "rm -rf logs/*.log*",
    "reset": "rm -rf .wwebjs_auth .wwebjs_cache data/*.json logs core dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shyland-dev/WA-Bot.git"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "wa"
  ],
