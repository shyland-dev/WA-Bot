{
  "name": "wa-bot",
  "version": "1.0.3",
  "description": "TODO",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node dist/index.js",
    "watch": "nodemon --watch src --ext ts --exec ts-node src/index.ts",
    "build": "tsc",
    "prettier": "prettier --write \"src/**/*.ts\"",
    "pm2:start": "pm2 start ecosystem.config.js --only wa-bot && pm2 save",
    "pm2:stop": "pm2 stop wa-bot || true",
    "pm2:delete": "pm2 delete wa-bot || true && pm2 save",
    "pm2:clean": "rm -rf .wwebjs_auth .wwebjs_cache",
    "pm2:reset": "npm run pm2:delete && npm run pm2:clean",
    "pm2:prod": "npm run build && npm run pm2:reset && npm run pm2:start && pm2 startup",
    "logs:clear": "rm -f logs/debug.log",
    "logs:view": "tail -f logs/debug.log",
    "logs:view-all": "cat logs/debug.log",
    "clear-all": "npm run logs:clear && npm run pm2:clean"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shyland-dev/WA-Bot.git"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "wa"
  ],
  "author": "shyland-dev",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/shyland-dev/WA-Bot/issues"
  },
  "homepage": "https://github.com/shyland-dev/WA-Bot#readme",
  "dependencies": {
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "github:pedroslopez/whatsapp-web.js#main"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/qrcode-terminal": "^0.12.2",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
