{
  "name": "wa-bot",
  "version": "1.0.2",
  "description": "TODO",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "dev:watch": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "prettier": "prettier --write \"src/**/*.ts\"",
    "pm2:dev": "pm2 start ecosystem.config.js --only wa-bot-dev",
    "pm2:prod": "npm run build && pm2 start ecosystem.config.js --only wa-bot",
    "pm2:stop": "pm2 stop all",
    "pm2:restart": "pm2 restart all",
    "pm2:logs": "pm2 logs",
    "pm2:monit": "pm2 monit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shyland-dev/WA-Bot.git"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "wa"
  ],
  "author": "shyland-dev",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/shyland-dev/WA-Bot/issues"
  },
  "homepage": "https://github.com/shyland-dev/WA-Bot#readme",
  "dependencies": {
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.34.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/qrcode-terminal": "^0.12.2",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
